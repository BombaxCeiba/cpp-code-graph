@echo off
rem ccg PATH installer (Windows variant). The contract in short: two
rem forwarding shims into a bin directory plus one PATH entry, idempotent,
rem and nothing outside the bin directory and the user Path registry value
rem is touched (fuller statement in the sections below).
rem
rem Definition: writes two forwarding shims into a bin directory - ccg.cmd
rem (resolved by cmd.exe/PowerShell through PATHEXT) and an extensionless
rem `ccg` (resolved first by Git Bash and other POSIX shells) - each
rem forwarding to the release binary by absolute path, then adds the bin
rem directory to the USER Path registry value.
rem
rem Soundness boundary: nothing outside the bin directory and the user
rem Path registry value is touched; the release directory is never
rem modified; the CURRENT shell's environment is never edited (PATH
rem changes land in new shells only). The Path write goes through
rem [Environment]::SetEnvironmentVariable - never setx, whose 1024-char
rem truncation would destroy long PATHs. Idempotent: re-running refreshes
rem the shims and never duplicates the Path entry.
rem
rem Fallbacks: CCG_BIN pointing at the binary stays honored by the hook
rem trampolines before any PATH lookup; the release directory itself can
rem be added to PATH by hand - those two are the manual shapes. Without
rem powershell.exe only the bash shim and the Path edit are skipped
rem (loudly) - the ccg.cmd shim still works.
rem
rem usage: ccg-install.cmd [release-dir] [--bin DIR] [--no-path]
rem   release-dir  directory holding ccg.exe + .ccg + docs
rem                (default: this script's own directory)
rem   --bin DIR    where the shims go (default: %LOCALAPPDATA%\ccg\bin)
rem   --no-path    write the shims but leave the user Path untouched
setlocal EnableExtensions
set "RELEASE=%~dp0"
set "BINDIR=%LOCALAPPDATA%\ccg\bin"
set "ADDPATH=1"

:parse
if "%~1"=="" goto parsed
if /i "%~1"=="--bin" (
    if "%~2"=="" (
        echo ccg-install: --bin needs a directory argument 1>&2
        exit /b 1
    )
    set "BINDIR=%~2"
    shift
    shift
    goto parse
)
if /i "%~1"=="--no-path" (
    set "ADDPATH=0"
    shift
    goto parse
)
set "RELEASE=%~1"
shift
goto parse

:parsed
if not "%RELEASE:~-1%"=="\" set "RELEASE=%RELEASE%\"
if not exist "%RELEASE%ccg.exe" (
    echo ccg-install: no ccg.exe in "%RELEASE%" 1>&2
    echo ccg-install: pass the release directory ^(cmake --install output^) as the first argument 1>&2
    exit /b 1
)
where powershell >nul 2>nul
if errorlevel 1 (
    echo ccg-install: powershell.exe not found - bash shim and Path edit skipped 1>&2
    set "HAVE_PS=0"
) else (
    set "HAVE_PS=1"
)

rem Absolute native path of the resolved binary (quotes stay out of the
rem variable); the forward-slash twin is for the bash shim, where native
rem separators would read as escapes.
for %%I in ("%RELEASE%ccg.exe") do set "CCGEXE=%%~fI"
set "CCGFWD=%CCGEXE:\=/%"

if not exist "%BINDIR%" mkdir "%BINDIR%"
if not exist "%BINDIR%" (
    echo ccg-install: cannot create "%BINDIR%" 1>&2
    exit /b 1
)

rem cmd/PowerShell shim: CRLF endings, written natively - no PowerShell
rem dependency for the primary Windows artifact.
> "%BINDIR%\ccg.cmd" (
    echo @rem ccg shim generated by ccg-install.cmd - forwards to the release binary
    echo @"%CCGEXE%" %%*
)

rem bash shim: MUST be LF-only - Git Bash refuses a CRLF shebang. Written
rem through PowerShell WriteAllText (UTF-8, no BOM, explicit [char]10)
rem with [char]34 for the embedded quotes, keeping the whole -Command
rem argument free of nested double quotes for safe cmd -^> argv passing.
if "%HAVE_PS%"=="1" (
    powershell -NoProfile -Command "$exe='%CCGFWD%'; $dst='%BINDIR%\ccg'; $q=[char]34; [IO.File]::WriteAllText($dst, '#!/bin/sh' + [char]10 + 'exec ' + $q + $exe + $q + ' ' + $q + '$@' + $q)"
)

if "%ADDPATH%"=="1" (
    if "%HAVE_PS%"=="1" (
        rem Split/filter/rejoin instead of string append: keeps the
        rem idempotency check meaningful when trailing or doubled
        rem semicolons drift into the registry value.
        powershell -NoProfile -Command "$bin='%BINDIR%'; $p=[Environment]::GetEnvironmentVariable('Path','User'); if (-not $p) { $p = '' }; $parts=@($p -split ';' | Where-Object { $_ -ne '' }); if (-not ($parts -contains $bin)) { [Environment]::SetEnvironmentVariable('Path', ($parts + $bin) -join ';', 'User'); Write-Output ('ccg-install: added ' + $bin + ' to the user Path') } else { Write-Output ('ccg-install: ' + $bin + ' already on the user Path') }"
    ) else (
        echo ccg-install: add "%BINDIR%" to your PATH manually 1>&2
    )
)

echo ccg-install: binary    %CCGEXE%
echo ccg-install: shim      %BINDIR%\ccg.cmd
if "%HAVE_PS%"=="1" echo ccg-install: shim      %BINDIR%\ccg ^(bash^)
echo ccg-install: docs      %RELEASE%docs
echo ccg-install: open a NEW terminal ^(PATH edits never touch the current shell^), then: ccg --version
echo ccg-install: Claude Code integration: ccg hook install --project ^(run in your project root^)
endlocal
exit /b 0
