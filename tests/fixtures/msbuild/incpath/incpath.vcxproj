  <PropertyGroup Label="UserMacros"></PropertyGroup>
  <!-- The pattern under test: MSBuild delivers these include directories to
       cl ONLY through the INCLUDE environment (VC++ Include Directories /
       the IncludePath property) - no /I flag exists for them. The relative
       entry stays relative in the env value (cl resolves it against the
       project working directory); the $(ProjectDir) entry arrives absolute
       with a doubled separator. $(IncludePath) keeps the toolset chain so
       the wrapped build itself compiles clean. -->
  <PropertyGroup>
    <IncludePath>inc;$(ProjectDir)inc2;$(IncludePath)</IncludePath>
    <OutDir>$(MSBuildProjectDirectory)\build\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildProjectDirectory)\build\$(Configuration)\obj\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <SDLCheck>true</SDLCheck>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="src\main.cpp" />
    <ClCompile Include="src\calc.cpp" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets"></ImportGroup>
</Project>
